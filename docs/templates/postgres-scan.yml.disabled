# INERT TEMPLATE: outside .github/workflows, deliberately not a runnable workflow.
# Replace the old workflow only during the authorized single-writer cutover.
name: PostgreSQL job watch scan
on:
  workflow_dispatch:
  schedule:
    - cron: '27 7 * * *'
permissions:
  contents: read
concurrency:
  group: jobwatch-postgresql
  cancel-in-progress: false
jobs:
  scan:
    if: github.event.repository.private == true && github.ref_name == github.event.repository.default_branch
    runs-on: ubuntu-latest
    timeout-minutes: 15
    env:
      JOBWATCH_DATABASE_URL: ${{ secrets.JOBWATCH_COLLECTOR_DATABASE_URL }}
    steps:
      - uses: actions/checkout@v4
        with:
          persist-credentials: false
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: python -m pip install -e '.[postgres]'
      - name: Collect monitored PostgreSQL sources
        id: collect
        continue-on-error: true
        shell: bash
        run: |
          set +e
          jobwatch-pg-ops scan --actor "collector:github:${GITHUB_RUN_ID}:${GITHUB_RUN_ATTEMPT}" > "$RUNNER_TEMP/jobwatch-pg-scan.json"
          code=$?
          echo "exit_code=$code" >> "$GITHUB_OUTPUT"
          exit "$code"
      - name: Public source summary (no owner credential or records)
        if: always()
        shell: bash
        run: |
          python - <<'PY'
          import json, os
          from pathlib import Path
          try:
              from jobwatch.postgres.orchestrator import actions_summary
              result = json.loads((Path(os.environ['RUNNER_TEMP']) / 'jobwatch-pg-scan.json').read_text())
              if result.get('schema') != 'jobwatch.postgres.scan/1':
                  raise ValueError('No complete summary')
              summary = actions_summary(result)
          except Exception:
              summary = 'No confirmed complete summary. Inspect collection_runs; prior source commits may exist.\n'
          with open(os.environ['GITHUB_STEP_SUMMARY'], 'a') as output:
              output.write(summary)
          PY
      - name: Surface incomplete or failed collections
        if: steps.collect.outcome == 'failure'
        run: |
          echo 'Collection was not fully successful. Independent source commits remain valid; inspect SQL run outcomes.'
          exit 1
# No migration, importer, owner credential, data-file staging, git commit or push.
