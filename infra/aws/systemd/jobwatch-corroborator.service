[Unit]
Description=Job Watch isolated public evidence corroborator (nftables-jailed; append-only)
Requires=jobwatch-postgresql.service nftables.service
After=jobwatch-postgresql.service nftables.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jobwatch-corroborator
Group=jobwatch-db
Environment="JOBWATCH_DATABASE_URL=host=/run/jobwatch-postgresql dbname=jobwatch user=jobwatch_corroborator"
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/jobwatch/current/venv/bin/jobwatch-evidence corroborate --limit 10
MemoryMax=192M
CPUQuota=30%
TimeoutStartSec=120
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
UMask=0077
