# REVIEW-ONLY TEMPLATE: Do NOT install or enable in production until remote evidence
# ingestion / recurring corroboration is explicitly approved by the owner.
# Runs `jobwatch-corroborator.service` (nftables UID 984 egress jail, --limit 10,
# MemoryMax=192M, CPUQuota=30%, TimeoutStartSec=120) every 30 minutes.
[Unit]
Description=Bounded recurring public evidence corroboration timer (every 30 min; nftables-jailed)

[Timer]
OnCalendar=*:05,35:00 UTC
RandomizedDelaySec=2min
Persistent=false
Unit=jobwatch-corroborator.service

[Install]
WantedBy=timers.target
