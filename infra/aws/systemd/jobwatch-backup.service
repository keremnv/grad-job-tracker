[Unit]
Description=Job Watch encrypted S3 PostgreSQL backup
Requires=jobwatch-postgresql.service
After=jobwatch-postgresql.service network-online.target
Wants=network-online.target
StartLimitIntervalSec=21600
StartLimitBurst=3
[Service]
Type=oneshot
User=jobwatch-backup
Group=jobwatch-db
Environment=JOBWATCH_MIGRATION_DATABASE_URL=host=/run/jobwatch-postgresql dbname=jobwatch user=jobwatch_migrator
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/jobwatch/current/venv/bin/python /opt/jobwatch/current/infra/aws/scripts/run_operation.py backup
TimeoutStartSec=45min
Restart=on-failure
RestartSec=15min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
UMask=0077
