{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "InspectDedicatedStateBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::BUCKET_NAME"
    },
    {
      "Sid": "ReadWriteCurrentState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME/tracker/terraform.tfstate"
    },
    {
      "Sid": "AcquireAndReleaseNativeLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::BUCKET_NAME/tracker/terraform.tfstate.tflock"
    }
  ]
}
