#!/usr/bin/python3
"""Owner-only interactive entry of one tunnel ID and its runtime key. Never prints the key; starts nothing.

Usage (as root, from an interactive Session Manager session): jobwatch-tunnel-credential read|owner [--rotate]
"""
import getpass,grp,os,re,sys,tempfile
from pathlib import Path

def write(path,text,uid,gid,mode):
    fd,tmp=tempfile.mkstemp(prefix='.'+path.name+'.',dir=path.parent)
    try:
        with os.fdopen(fd,'w') as f:f.write(text);f.flush();os.fsync(f.fileno())
        os.chown(tmp,uid,gid);os.chmod(tmp,mode);os.replace(tmp,path)
    finally:
        if os.path.exists(tmp):os.unlink(tmp)

def main():
    args=sys.argv[1:]
    if os.geteuid()!=0 or not args or args[0] not in ('read','owner') or args[1:] not in ([],['--rotate']):
        raise SystemExit('Run as root: jobwatch-tunnel-credential read|owner [--rotate]')
    if not sys.stdin.isatty():raise SystemExit('Interactive terminal required; never pipe a key')
    which=args[0];rotate=args[1:]==['--rotate']
    env=Path(f'/etc/jobwatch/tunnel-{which}.env');profile=Path(f'/etc/jobwatch-tunnel/{which}.yaml')
    if (env.exists() or profile.exists()) and not rotate:
        raise SystemExit('Credentials already present; inspect, or rerun with --rotate to replace them')
    template=Path(f'/opt/jobwatch/current/infra/aws/integrations/examples/tunnel-{which}.yaml.example').read_text()
    placeholder=f'REPLACE_WITH_PERSONAL_{which.upper()}_TUNNEL_ID'
    if template.count(placeholder)!=1:raise SystemExit('Unexpected profile template')
    tunnel=input(f'{which} tunnel ID (tunnel_ followed by 32 hex characters): ').strip()
    if not re.fullmatch(r'tunnel_[0-9a-f]{32}',tunnel):raise SystemExit('Unexpected tunnel ID format; nothing saved')
    key=getpass.getpass(f'{which} runtime key with Tunnels Read + Use only (hidden): ')
    if not key.startswith('sk-') or len(key)<24 or any(c.isspace() for c in key):
        raise SystemExit('Unexpected key format; nothing saved')
    group=grp.getgrnam(f'jobwatch-tunnel-{which}').gr_gid
    write(env,'CONTROL_PLANE_API_KEY='+key+'\n',0,0,0o600)
    write(profile,template.replace(placeholder,tunnel),0,group,0o640)
    print(f'Saved {which} tunnel ID and key privately; the key was not printed. Nothing was started.')

if __name__=='__main__':main()
